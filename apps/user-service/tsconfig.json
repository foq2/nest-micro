{
  "extends": "@repo/typescript-config/nestjs",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": "./",
    "rootDir": "src",
    "strictPropertyInitialization": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
